<Patch>
<!-- Restrict Ork & Grot Abilities: TheForce -->
<Operation Class="PatchOperationSequence">
<success>Always</success>
<operations>
	<li Class="PatchOperationTest">
		<xpath>/Defs/TraitDef[defName = "PJ_ForceSensitive"]</xpath>
	</li>
	<li Class="PatchOperationTest">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Ork_Base_Child" or @Name = "Ork_Base" or starts-with(defName,'Ork_Boy_') or starts-with(defName,'Ork_Nob_') or starts-with(defName,'Ork_Boss_')]/disallowedTraits</xpath>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Ork_Base_Child" or @Name = "Ork_Base" or starts-with(defName,'Ork_Boy_') or starts-with(defName,'Ork_Nob_') or starts-with(defName,'Ork_Boss_')]/disallowedTraits</xpath>
		<value>
			<li>
				<defName>PJ_ForceSensitive</defName>
			</li>
			<li>
				<defName>PJ_JediTrait</defName>
			</li>
			<li>
				<defName>PJ_SithTrait</defName>
			</li>
			<li>
				<defName>PJ_GrayTrait</defName>
			</li>
		</value>
	</li>
	<li Class="PatchOperationTest">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Grot_Base_Child" or @Name = "Grot_Base" or starts-with(defName,'Grot_')]/disallowedTraits</xpath>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Grot_Base_Child" or @Name = "Grot_Base" or starts-with(defName,'Grot_')]/disallowedTraits</xpath>
		<value>
			<li>
				<defName>PJ_ForceSensitive</defName>
			</li>
			<li>
				<defName>PJ_JediTrait</defName>
			</li>
			<li>
				<defName>PJ_SithTrait</defName>
			</li>
			<li>
				<defName>PJ_GrayTrait</defName>
			</li>
		</value>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Ork_Weird_Boy" or defName = "Ork_Weird_Nob" or defName = "Ork_Weird_Boss" or defName = "Weird_Grot"]/forcedTraits</xpath>
		<value>	
			<li>
				<defName Degree="1">PJ_SithTrait</defName>
				<chance>50</chance>
			</li>
			<li>
				<defName Degree="2">PJ_SithTrait</defName>
				<chance>35</chance>
			</li>
			<li>
				<defName Degree="3">PJ_SithTrait</defName>
				<chance>15</chance>
			</li>
			<li>
				<defName Degree="4">PJ_SithTrait</defName>
				<chance>5</chance>
			</li>
		</value>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Ork_Weird_Child"]/forcedTraits</xpath>
		<value>	
			<li>
				<defName Degree="1">PJ_ForceSensitive</defName>
				<chance>75</chance>
			</li>
			<li>
				<defName Degree="2">PJ_ForceSensitive</defName>
				<chance>50</chance>
			</li>
		</value>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>/Defs/AlienRace.BackstoryDef[defName = "Ork_Weird_Child"]/disallowedTraits</xpath>
		<value>	
			<li>
				<defName>PJ_JediTrait</defName>
			</li>
			<li>
				<defName>PJ_GrayTrait</defName>
			</li>
		</value>
	</li>
</operations>
</Operation>

